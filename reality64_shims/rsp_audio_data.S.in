#if defined(__APPLE__) || (defined(_WIN32) && defined(__i386__))
#define SYMBOL(name) _##name
#else
#define SYMBOL(name) name
#endif

#ifdef __APPLE__
.section __TEXT,__const
#else
.section .rodata
#endif
.balign 8
.globl SYMBOL(rspAspMainDataStart)
.globl SYMBOL(rspAspMainDataEnd)
SYMBOL(rspAspMainDataStart):
.incbin "@CMAKE_CURRENT_BINARY_DIR@/rsp/audio_data.bin"
SYMBOL(rspAspMainDataEnd):
.if (SYMBOL(rspAspMainDataEnd) - SYMBOL(rspAspMainDataStart)) != 704
.error "classic US aspMain data must be 704 bytes"
.endif

#if defined(__ELF__)
.section .note.GNU-stack,"",@progbits
#endif
